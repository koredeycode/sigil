# ─── SIGIL ENVIRONMENT VARIABLES ──────────────────────────────────────────────
# Copy this file to .env and configure as needed.

# The port you want the Sigil API Server to run on (default 7445)
PORT=7445

# The Logging verbosity level (debug, info, warn, error)
LOG_LEVEL=info

# Custom Solana RPC URL (default: https://api.devnet.solana.com)
RPC_URL=https://api.devnet.solana.com

# Custom Path to the built React dashboard (used by developers running packages/core locally)
WEB_DIST_PATH=

# LLM Provider API Keys (Sigil normally manages these via OS Keychain or the internal DB,
# but they can be passed via environment variables for overriding behavior in tools like SolanaAgentKit)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
