{
  "name": "sigil",
  "version": "0.2.2",
  "private": true,
  "description": "The Local-First Autonomous Agent for Solana",
  "scripts": {
    "dev:core": "pnpm --filter sigil-core run dev",
    "dev:tui": "pnpm --filter sigil-tui run dev",
    "dev:web": "pnpm --filter sigil-web run dev",
    "dev:site": "pnpm --filter site run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "rpc-websockets": "^9.0.4",
      "@solana/web3.js": "^1.98.0"
    }
  }
}
