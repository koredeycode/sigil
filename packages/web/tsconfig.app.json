{
  "compilerOptions": {
    // Incremental compilation cache for faster rebuilds
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // Target modern browsers with ES2022 features
    "target": "ES2022",

    // Use standard ES2022 class field behavior
    "useDefineForClassFields": true,

    // Include browser DOM APIs and modern JavaScript features
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Latest module syntax for optimal bundler output
    "module": "ESNext",

    // Include Vite's client type definitions
    "types": ["vite/client"],

    // Skip type checking of .d.ts files for faster compilation
    "skipLibCheck": true,

    /* Bundler mode - Optimized for Vite */
    // Use Vite's custom module resolution algorithm
    "moduleResolution": "bundler",

    // Allow importing .ts/.tsx files directly (Vite handles this)
    "allowImportingTsExtensions": true,

    // Preserve import/export syntax exactly as written
    "verbatimModuleSyntax": true,

    // Treat all files as modules (even without imports/exports)
    "moduleDetection": "force",

    // Don't emit JavaScript (Vite handles bundling)
    "noEmit": true,

    // Use React 19's automatic JSX runtime
    "jsx": "react-jsx",

    /* Linting - Additional code quality checks */
    // Enable all strict type-checking options
    "strict": true,

    // Error on unused local variables
    "noUnusedLocals": true,

    // Error on unused function parameters
    "noUnusedParameters": true,

    // Only allow syntax that can be safely erased
    "erasableSyntaxOnly": true,

    // Prevent forgetting break/return in switch cases
    "noFallthroughCasesInSwitch": true,

    // Error on imports that may have side effects
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
