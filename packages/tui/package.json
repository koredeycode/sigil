{
  "name": "sigil-tui",
  "version": "0.1.0",
  "description": "Sigil terminal UI — Ink (React for CLI)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/app.tsx",
    "build": "tsc",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "cli-md": "^1.2.0",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
