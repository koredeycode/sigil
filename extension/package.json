{
  "name": "sigil",
  "displayName": "Sigil",
  "version": "0.1.0",
  "description": "A browser extension that interfaces with a local-first AI agent to sign and evaluate Solana transactions.",
  "author": "Yusuf Akorede <koredey4u@gmail.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package && cp build/chrome-mv3-prod.zip ../site/public/sigil-extension.zip"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "eventemitter3": "^5.0.4",
    "plasmo": "0.90.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/bs58": "^5.0.0",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prettier": "3.2.4",
    "typescript": "^5.7.3"
  },
  "manifest": {
    "permissions": ["storage"],
    "host_permissions": [
      "https://*/*"
    ]
  }
}
